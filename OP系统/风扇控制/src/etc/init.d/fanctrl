#!/bin/sh /etc/rc.common
# Copyright (C) 2026 fanctrl
START=98
STOP=10
USE_PROCD=1
NAME=fanctrl
PROG=/usr/sbin/fanctrld

start_service() {
    config_load "$NAME"
    local enabled
    config_get enabled settings enabled 1
    [ "$enabled" = "1" ] || {
        logger -t "$NAME" "Fan control disabled; patrol daemon not started"
        return 0
    }

    echo 1 > /sys/class/gpio/fan-hw/value 2>/dev/null
    echo 1 > /sys/bus/platform/devices/pwm-fan/hwmon/hwmon1/pwm1_enable 2>/dev/null

    procd_open_instance "$NAME"
    procd_set_param command "$PROG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # Restore a conservative default on explicit service stop/removal.
    echo 1 > /sys/class/gpio/fan-hw/value 2>/dev/null
    echo 1 > /sys/bus/platform/devices/pwm-fan/hwmon/hwmon1/pwm1_enable 2>/dev/null
    echo 128 > /sys/bus/platform/devices/pwm-fan/hwmon/hwmon1/pwm1 2>/dev/null
}

service_triggers() {
    procd_add_reload_trigger "$NAME"
}
