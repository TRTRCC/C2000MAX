config fanctrl 'settings'
    option enabled '1'
    option mode 'balanced'
    option manual_pwm '128'
    option debounce_pct '5'
    option debounce_sec '30'
    option hysteresis '3'
    option curve_schema_version '2'

config curve 'silent'
    option temps '45,55,65,75,85,95'
    option speeds '8,15,28,42,62,82'

config curve 'balanced'
    option temps '40,50,60,70,80,90'
    option speeds '20,35,52,68,84,100'

config curve 'performance'
    option temps '35,45,55,65,75,85'
    option speeds '35,55,70,82,92,100'

config curve 'custom'
    option temps '35,50,65,80,95'
    option speeds '20,35,55,75,100'
